    <dip bits="11,12" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="13" name="Allow Continue" ids="Yes,No"/>
    <dip bits="14" name="Demo Sounds" ids="On,Off"/>
    <dip bits="15" name="Coin Chute" ids="Twin,Single"/>
  </switches>
  <buttons names="Trigger,Bomb,Start,Coin,Pause,Test,Service" default="A,B,Start,R,X,L,Select"/>
