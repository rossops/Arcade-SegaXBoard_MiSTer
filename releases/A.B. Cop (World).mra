    <dip bits="10" name="Allow Continue" ids="Yes,No"/>
    <dip bits="12,13" name="Time" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="14,15" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
  </switches>
  <buttons names="-,Jump,Start,Coin,Test,Service,Pause,Gas,Brake" default="A,B,Start,R,L,Select,X,Y,L2"/>
